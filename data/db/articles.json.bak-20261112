    "Ministry",
    "Church Planting",
    "Mission",
    "Urban Ministry"
   ],
   "language": "en",
   "country": "US",
   "region": "",
   "stance": "evangelical",
   "flags": [],
   "priority": 2,
   "fetched_at": "2026-11-11T00:25:53.172167",
   "extra": {
