  {
   "title": "What God Requires",
   "url": "https://odb.org/2026/11/07/",
   "category": "devotional",
   "source": "Our Daily Bread (English)",
   "source_url": "https://odb.org/feed/",
   "published": "2026-11-11",
   "summary": "You’ve probably seen the signs: No Shirt. No Shoes. No Service.",
   "summary_zh": "您可能已经看到过这样的迹象：不穿衬衫。请勿穿鞋。请勿提供服务。",
   "title_zh": "神的要求",
   "content": "Our Daily Bread Devotionals",
   "content_zh": "我们的每日面包祈祷会",
   "image": "https://odb.org/globalassets/global/logos/parent-logos/odb_parentbrand_logo_8-9-24_fullclr_icon.png?width=1200&height=680&rmode=max",
   "author": "John Blase",
   "tags": [],
   "language": "en",
   "country": "US",
   "region": "",
   "stance": "evangelical",
   "flags": [],
   "priority": 2,
   "fetched_at": "2026-11-11T00:25:56.112954",
