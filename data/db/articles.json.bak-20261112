  {
   "title": "God Our King",
   "url": "https://odb.org/2026/11/02/",
   "category": "devotional",
   "source": "Our Daily Bread (English)",
   "source_url": "https://odb.org/feed/",
   "published": "2026-11-11",
   "summary": "After being jobless for a year, Ethan finally got a good offer—but his wife stopped him from accepting it. “Is this good for you?” she asked.",
   "summary_zh": "在失业一年后，伊森终于得到了一个很好的报价，但他的妻子阻止了他接受。“这对你有好处吗？”她问。",
   "title_zh": "上帝，我们的王",
   "content": "Our Daily Bread Devotionals",
   "content_zh": "我们的每日面包祈祷会",
   "image": "https://odb.org/globalassets/global/logos/parent-logos/odb_parentbrand_logo_8-9-24_fullclr_icon.png?width=1200&height=680&rmode=max",
