   "image": "https://tgc-static.oss-cn-hongkong.aliyuncs.com/wp/2026/11/book-review-finding-grace-dementia.jpg",
   "author": "Kathryn Butler",
   "tags": [],
   "language": "zh",
   "country": "CN",
