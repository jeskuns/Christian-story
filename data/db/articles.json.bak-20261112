   "title": "0360 | Revive Our Hearts | Psalm 85 | 20020623 | Pastor Min Joshua Chung",
   "url": "https://news.google.com/rss/articles/CBMiQkFVX3lxTE8wZ3BVT3dpaFQ1Zk5RV1FoNk9qWjNNZXBrUlo1b0Z3ZXdIYzhnczZTNm9kOTA1R3ExRUotcTdTVzlvQQ?oc=5",
